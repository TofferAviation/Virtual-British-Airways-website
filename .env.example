# British Airways Virtual production environment template
# Copy to .env.local and fill in real values. Never commit secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary private development preview gate
BAV_PREVIEW_PROTECTION=false
BAV_PREVIEW_PASSWORD=

# Database (future production migration target for the current local BAV stores)
DATABASE_URL=

# Native BAV pilot authentication
# Use a long, unique random value (24+ characters). During migration the staff
# session secret is accepted as a fallback, but production should use a separate key.
BAV_PILOT_SESSION_SECRET=replace-with-a-long-random-pilot-session-secret

# FreeFlight BAV ACARS authentication
# Optional during local development: BAV_PILOT_SESSION_SECRET is used as a fallback.
# Production should use its own long random secret for ACARS bearer tokens.
BAV_ACARS_SECRET=replace-with-a-long-random-acars-secret

# Staff Centre authentication
# BAV_STAFF_EMAIL is the protected Master Admin account. Use your private owner email here.
# This account always receives every staff permission and cannot be demoted or deactivated from Staff Centre.
BAV_STAFF_EMAIL=owner-private-email@example.com
BAV_STAFF_PASSWORD=replace-with-a-strong-password
BAV_STAFF_DISPLAY_NAME=Owner
BAV_STAFF_SESSION_SECRET=replace-with-a-long-random-session-secret
