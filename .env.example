# British Airways Virtual production environment template
# Copy to .env.local and fill in real values. Never commit secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (future shared production store)
DATABASE_URL=

# vAMSYS (future - exact variables depend on approved API/SSO flow)
VAMSYS_CLIENT_ID=
VAMSYS_CLIENT_SECRET=
VAMSYS_REDIRECT_URI=http://localhost:3000/api/auth/vamsys/callback

# Phoenix / FreeFlight integration (future)
PHOENIX_API_BASE_URL=
PHOENIX_API_KEY=

# Pilot session/authentication
AUTH_SECRET=

# Staff Centre authentication
# Use a long, unique random value for BAV_STAFF_SESSION_SECRET (24+ characters).
BAV_STAFF_EMAIL=admin@example.com
BAV_STAFF_PASSWORD=replace-with-a-strong-password
BAV_STAFF_DISPLAY_NAME=Administrator
BAV_STAFF_SESSION_SECRET=replace-with-a-long-random-session-secret
