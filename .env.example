# Copy this file to .env.local for local development. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_project_secret_key
BAV_PILOT_SESSION_SECRET=replace_with_a_random_32_character_or_longer_secret
BAV_STAFF_SESSION_SECRET=replace_with_a_different_random_32_character_or_longer_secret

# Optional in local development. Required in production for welcome emails,
# password resets, and Staff Centre invitation delivery.
BAV_SMTP_HOST=smtp.gmail.com
BAV_SMTP_PORT=465
BAV_SMTP_SECURE=true
BAV_SMTP_USER=no-reply@your-domain.example
BAV_SMTP_PASSWORD=replace_with_a_google_app_password
BAV_EMAIL_FROM=British Airways Virtual <support@your-domain.example>
BAV_EMAIL_REPLY_TO=support@your-domain.example
# Optional override used only while the closed-beta flag is enabled.
BAV_CLOSED_BETA_EMAIL_FROM=Private Aviation Preview <no-reply@your-domain.example>
BAV_CLOSED_BETA_EMAIL_REPLY_TO=no-reply@your-domain.example
BAV_PUBLIC_SITE_URL=https://your-domain.example
BAV_PASSWORD_RESET_SECRET=replace_with_a_different_random_32_character_or_longer_secret

# Closed beta is invitation-only. When enabled, only pilots granted access in
# Staff Centre → User permissions can reach the public website.
BAV_CLOSED_BETA_ENABLED=false

# Optional: only enable when sharing a private development preview.
BAV_PREVIEW_PROTECTION=false
BAV_PREVIEW_PASSWORD=

# Career enhancements are deliberately opt-in. The current Career, Finance and
# Qualifications systems remain available independently of these switches.
# Allowed values: disabled, staff, enabled. Use enabled only after review.
BAV_FEATURE_CAREER_EXPERIENCE=disabled
BAV_FEATURE_CAREER_DISPATCHER=disabled
BAV_FEATURE_CAREER_DEBRIEF=disabled
BAV_FEATURE_CAREER_FLEET=disabled
BAV_FEATURE_CAREER_ROSTERS=disabled
BAV_FEATURE_CAREER_ADVANCED_OPERATIONS=disabled
BAV_FEATURE_CAREER_MENTORING=disabled
BAV_FEATURE_CAREER_PASSPORT=disabled

# Applies the Type Rating Academy's approved qualifications to aircraft access
# only for pilots who select Realistic Operations. Fly and Career retain open
# aircraft access. Keep disabled until the pilot data and staff processes are
# ready for the operational rollout. Legacy value true is also recognised.
BAV_CAREER_ENFORCEMENT=disabled
