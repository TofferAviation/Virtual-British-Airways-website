<Application x:Class="FreeFlight.BavAcars.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#061426" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0B2038" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#0E2946" />
        <SolidColorBrush x:Key="Panel3Brush" Color="#102D4D" />
        <SolidColorBrush x:Key="LineBrush" Color="#1D4569" />
        <SolidColorBrush x:Key="LineSoftBrush" Color="#163755" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F8FC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9BCD0" />
        <SolidColorBrush x:Key="BlueBrush" Color="#16A0FF" />
        <SolidColorBrush x:Key="BlueDarkBrush" Color="#0B67B8" />
        <SolidColorBrush x:Key="GreenBrush" Color="#3BE982" />
        <SolidColorBrush x:Key="RedBrush" Color="#ED2948" />

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#082344" Offset="0" />
            <GradientStop Color="#0A2A52" Offset="0.52" />
            <GradientStop Color="#071D38" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0E2946" Offset="0" />
            <GradientStop Color="#0A1E34" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessPanelBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0E4A3A" Offset="0" />
            <GradientStop Color="#0C3C34" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Border" x:Key="CardSurface">
            <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Foreground" Value="#DDEAF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBg" Property="Background" Value="#123B67" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBg" Property="Background" Value="#174D82" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0B72C8" />
            <Setter Property="BorderBrush" Value="#2AA7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#0B213B" />
            <Setter Property="BorderBrush" Value="#527492" />
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DE2742" />
            <Setter Property="BorderBrush" Value="#FF5368" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#07182B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#355B7D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#07182B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#355B7D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1E34" />
            <Setter Property="Foreground" Value="#0A1A2C" />
            <Setter Property="BorderBrush" Value="#355B7D" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Application.Resources>
</Application>
