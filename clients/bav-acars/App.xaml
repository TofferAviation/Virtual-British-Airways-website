<Application x:Class="FreeFlight.BavAcars.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#071426" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0D2038" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#102946" />
        <SolidColorBrush x:Key="LineBrush" Color="#244766" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9FB4C9" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1590FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#31D77C" />
        <SolidColorBrush x:Key="RedBrush" Color="#E1273E" />
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Foreground" Value="#DDE9F7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,13"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#14365B"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0B6FC2"/><Setter Property="BorderBrush" Value="#269BFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#D9233C"/><Setter Property="BorderBrush" Value="#FF4C62"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#07182B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#355B7D"/><Setter Property="Padding" Value="10"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#07182B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#355B7D"/><Setter Property="Padding" Value="10"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#0B1E34"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#355B7D"/><Setter Property="Padding" Value="8"/></Style>
    </Application.Resources>
</Application>
