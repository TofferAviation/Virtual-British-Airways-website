<Window x:Class="FreeFlight.BavAcars.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeFlight BAV ACARS v1.0" Width="1500" Height="900" MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/></Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#092446" BorderBrush="#1D4B72" BorderThickness="0,0,0,1">
            <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="✈" FontSize="22" Margin="0,0,12,0"/><StackPanel><TextBlock Text="FreeFlight BAV ACARS" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="v1.0.0 · British Airways Virtual only" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel>
                <TextBlock Grid.Column="1" Text="BRITISH AIRWAYS  Virtual" FontFamily="Georgia" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/><TextBlock Text="Connected" VerticalAlignment="Center" Margin="0,0,22,0"/><StackPanel><TextBlock x:Name="PilotNameText" Text="Not signed in" FontWeight="SemiBold"/><TextBlock x:Name="PilotIdText" Text="BAV account" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#081A2F" BorderBrush="#173B5C" BorderThickness="0,0,1,0">
                <DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <Button Style="{StaticResource NavButton}" Background="#123C69" Click="Dashboard_Click">⌂   Dashboard</Button>
                    <Button Style="{StaticResource NavButton}" Click="Dashboard_Click">✈   My Flight</Button>
                    <Button Style="{StaticResource NavButton}" Click="Dashboard_Click">◎   Live Tracking</Button>
                    <Button Style="{StaticResource NavButton}" Tag="/account" Click="WebsiteNav_Click">▤   PIREPs</Button>
                    <Button Style="{StaticResource NavButton}" Tag="/account" Click="WebsiteNav_Click">▣   Assignments</Button>
                    <Button Style="{StaticResource NavButton}" Tag="/fleet" Click="WebsiteNav_Click">✈   Fleet</Button>
                    <Button Style="{StaticResource NavButton}" Tag="/support/tickets" Click="WebsiteNav_Click">◉   Support</Button>
                    <Button Style="{StaticResource NavButton}" Click="Settings_Click">⚙   Settings</Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,22"><Separator Background="#274B6C"/><TextBlock Text="A GLOBAL COMMUNITY" FontSize="11" FontWeight="Bold" Margin="0,16,0,4"/><TextBlock Text="A BRITISH SPIRIT" Foreground="{StaticResource MutedBrush}" FontSize="10"/><Border Background="#D9233C" Height="3" Width="72" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel>
                            <TextBlock x:Name="WelcomeText" Text="Welcome to BAV ACARS" FontSize="27" FontWeight="Light"/><TextBlock Text="Current assignment" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold" Margin="0,14,0,8"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="AssignmentFlightText" Text="NO FLIGHT" FontSize="34" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock x:Name="RouteText" Text="Book a flight on the BAV website" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ScheduleText" Text="No active schedule" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Grid>
                            <TextBlock x:Name="AircraftText" Text="Aircraft —" Margin="0,16,0,12" Foreground="#DCE8F5"/>
                            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Click="RefreshAssignment_Click" Margin="0,0,10,0">↻  Sync assignment</Button><Button x:Name="StartFlightButton" Style="{StaticResource DangerButton}" Click="StartFlight_Click" IsEnabled="False">▶  Start flight</Button></StackPanel>
                        </StackPanel></Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,10"><StackPanel>
                            <DockPanel><TextBlock Text="Simulator detection" FontSize="17" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" Background="#103E2C" CornerRadius="12" Padding="10,4"><TextBlock x:Name="SimulatorStatusText" Text="Scanning" Foreground="{StaticResource GreenBrush}" FontSize="11"/></Border></DockPanel>
                            <TextBlock Text="Detected simulator / adapter" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,6"/><ComboBox x:Name="SimulatorCombo" SelectionChanged="SimulatorCombo_SelectionChanged"/>
                            <Border Background="#0A1829" BorderBrush="#244766" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="DetectedSimulatorText" Text="No simulator detected" FontWeight="SemiBold"/><TextBlock x:Name="NativeTelemetryText" Text="Process detection ready · native telemetry adapter pending" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="DetectSimulator_Click">Scan simulators</Button>
                        </StackPanel></Border>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="ALTITUDE"/><TextBlock x:Name="AltitudeText" Style="{StaticResource MetricValue}" Text="—"/><TextBlock x:Name="AltitudeSubText" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="GROUND SPEED"/><TextBlock x:Name="GroundSpeedText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="VERTICAL SPEED"/><TextBlock x:Name="VerticalSpeedText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="HEADING"/><TextBlock x:Name="HeadingText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="FUEL"/><TextBlock x:Name="FuelText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="FLIGHT TIME"/><TextBlock x:Name="FlightTimeText" Style="{StaticResource MetricValue}" Text="00:00"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,0"><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="FLIGHT PHASE"/><TextBlock x:Name="FlightPhaseText" Style="{StaticResource MetricValue}" Text="STANDBY"/></StackPanel></Border>
                    </UniformGrid>

                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="Live route &amp; tracking" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,22,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="3*"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DepartureCodeText" Text="LHR" FontSize="20" FontWeight="Bold"/><TextBlock Text="Departure" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><Grid Grid.Column="1" Margin="18,0"><ProgressBar x:Name="RouteProgress" Height="8" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Foreground="{StaticResource BlueBrush}" Background="#16334F"/><TextBlock Text="✈" FontSize="22" HorizontalAlignment="Center" Margin="0,-28,0,0"/></Grid><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="ArrivalCodeText" Text="JFK" FontSize="20" FontWeight="Bold"/><TextBlock Text="Arrival" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Grid><TextBlock x:Name="RouteDetailText" Text="Waiting for ACARS session" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,10"><StackPanel><DockPanel><TextBlock Text="Website integration" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="WebsiteStatusText" DockPanel.Dock="Right" Text="Offline" Foreground="{StaticResource GreenBrush}"/></DockPanel><Separator Background="#244766" Margin="0,12"/><TextBlock Text="Website sync" FontWeight="SemiBold"/><TextBlock x:Name="WebsiteSyncText" Text="Sign in to connect" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,10"/><TextBlock Text="Assignment sync" FontWeight="SemiBold"/><TextBlock x:Name="AssignmentSyncText" Text="Waiting" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,10"/><TextBlock Text="Automatic PIREP upload" FontWeight="SemiBold"/><TextBlock x:Name="PirepStatusText" Text="Ready after flight completion" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,10"/><TextBlock Text="Support ticket access" FontWeight="SemiBold"/><Button Style="{StaticResource PrimaryButton}" Tag="/support/tickets" Click="WebsiteNav_Click" Margin="0,7,0,0">Open BAV Support</Button></StackPanel></Border>
                    </Grid>

                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><DockPanel><TextBlock Text="Event log" FontSize="17" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="Flight events" Foreground="{StaticResource MutedBrush}"/></DockPanel><ListBox x:Name="EventList" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" MaxHeight="205"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource GreenBrush}"/><TextBlock Grid.Column="1" Text="{Binding Event}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><DockPanel><TextBlock Text="ACARS session" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="LastUpdateText" DockPanel.Dock="Right" Text="Not started" Foreground="{StaticResource MutedBrush}"/></DockPanel><Border Background="#103E2C" BorderBrush="#1B8053" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,14,0,12"><StackPanel><TextBlock x:Name="AcarsStatusText" Text="Standby" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TelemetrySourceText" Text="Website connected telemetry pipeline" Foreground="#BFEBD2" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="PACKETS"/><TextBlock x:Name="PacketsText" Text="0" FontSize="19"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource MetricLabel}" Text="QUEUED"/><TextBlock x:Name="QueueText" Text="0" FontSize="19"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource MetricLabel}" Text="SESSION"/><TextBlock x:Name="SessionIdText" Text="—" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="PauseButton" Style="{StaticResource PrimaryButton}" Click="Pause_Click" IsEnabled="False" Margin="0,0,10,0">Ⅱ  Pause tracking</Button><Button x:Name="EndFlightButton" Style="{StaticResource DangerButton}" Click="EndFlight_Click" IsEnabled="False">■  End flight</Button></StackPanel></StackPanel></Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#061323" BorderBrush="#173B5C" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><TextBlock x:Name="FooterStatusText" Text="●  ACARS ready" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="British Airways Virtual  ·  FreeFlight Systems" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel></Border>

        <Grid x:Name="LoginOverlay" Grid.RowSpan="3" Background="#F2071426">
            <Border Width="520" Padding="34" Background="#0C213A" BorderBrush="#2D5C84" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
                <TextBlock Text="BRITISH AIRWAYS  Virtual" FontFamily="Georgia" FontWeight="Bold" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="FreeFlight BAV ACARS v1.0" FontSize="18" HorizontalAlignment="Center" Margin="0,6,0,28" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="BAV website address" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="LoginBaseUrl" Text="http://localhost:3000" Margin="0,6,0,14"/>
                <TextBlock Text="Pilot email" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="LoginEmail" Margin="0,6,0,14"/>
                <TextBlock Text="Password" Foreground="{StaticResource MutedBrush}" FontSize="11"/><PasswordBox x:Name="LoginPassword" Margin="0,6,0,18"/>
                <TextBlock x:Name="LoginStatus" Text="Sign in with the same BAV account you use on the website." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Click="Login_Click" Padding="18,12">Sign in to BAV</Button>
                <TextBlock Text="Your password is sent only to your configured BAV website and is not stored by this application." Foreground="#718AA2" FontSize="10" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel></Border>
        </Grid>
    </Grid>
</Window>
